{
  "name": "temandor",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "trustedDependencies": [
    "esbuild",
    "vue-demi"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "bun scripts/serve.mjs",
    "mcp": "bun packages/mcp/src/cli.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc --noEmit -p packages/mcp/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@iconify-json/lucide": "^1.2.157",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/ui": "^4.13.0",
    "@pinia/nuxt": "^1.0.3",
    "@temandor/core": "workspace:*",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "svg2pdf.js": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.4.0",
    "@playwright/test": "1.65.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "typescript": "^6.0.3",
    "vitest": "5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
